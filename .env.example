# Copy to .env.local and fill in.
# Never commit a real value.

QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_API_KEY=

# live | fixture   — fixture is dev/test only, never a production fallback
QLOO_MODE=live

UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Constraint parsing only. Any OpenAI-compatible JSON-mode endpoint works.
DEEPSEEK_API_KEY=
